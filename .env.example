# Copy this file to .env and fill in real values. Never commit .env.

# On a single local/self-hosted Postgres, both can just point at the same
# database — there's no pooler in front of it, so pooled vs. direct doesn't
# matter. On a serverless host (Vercel, etc.) with a pooled provider (Vercel
# Postgres, Supabase, Neon, ...), DATABASE_URL MUST be the pooled connection
# string (e.g. Vercel Postgres' POSTGRES_PRISMA_URL) and DIRECT_URL the
# non-pooled one (e.g. POSTGRES_URL_NON_POOLING) — schema changes
# (`prisma db push`/`migrate`) require a direct connection, and using the
# non-pooled URL for ordinary runtime queries is what exhausts the
# database's connection limit under serverless traffic.
DATABASE_URL="postgresql://user:password@host:5432/dbname"
DIRECT_URL="postgresql://user:password@host:5432/dbname"

AWS_PROFILE=
AWS_REGION=
AWS_BUCKET_NAME=
AWS_FOLDER_PREFIX=

NEXTAUTH_SECRET=

# Powers the Bills & Income document-extraction pipeline (GPT-4o-mini
# vision + Structured Outputs). Without it, uploads fall back to a manual
# "needs confirmation" draft instead of calling OpenAI.
OPENAI_API_KEY=

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
