# Copy this file to .env and fill in real values. Never commit .env.

DATABASE_URL="postgresql://user:password@host:5432/dbname"

AWS_PROFILE=
AWS_REGION=
AWS_BUCKET_NAME=
AWS_FOLDER_PREFIX=

NEXTAUTH_SECRET=

# Powers the Bills & Income document-extraction pipeline (GPT-4o-mini
# vision + Structured Outputs). Without it, uploads fall back to a manual
# "needs confirmation" draft instead of calling OpenAI.
OPENAI_API_KEY=

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
